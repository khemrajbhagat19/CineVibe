# Docker Compose configuration only. For local Windows development, use backend/.env.example.
POSTGRES_DB=cinevibe
POSTGRES_USER=cinevibe
POSTGRES_PASSWORD=replace-this-database-password
DATABASE_URL=postgresql+psycopg://cinevibe:replace-this-database-password@db:5432/cinevibe
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@cinevibe.local
ADMIN_PASSWORD=ChangeMe@123
CORS_ORIGINS=http://localhost
MAX_UPLOAD_SIZE=2147483648
MEDIA_ROOT=/data/media
